# Build stage
FROM node:20-alpine as builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV NODE_ENV=production
RUN npm run build

# Production stage
# Use the standard alpine nginx image
FROM nginx:alpine AS runner
# Place the build under /usr/share/nginx/html/klaimaet so files match the Vite base path (/klaimaet/)
RUN mkdir -p /usr/share/nginx/html/klaimaet
COPY --from=builder /app/dist /usr/share/nginx/html/klaimaet
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]